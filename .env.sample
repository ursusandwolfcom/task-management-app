POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=task_management
POSTGRES_USER=task_management
POSTGRES_PASSWORD=replace_with_a_local_password
# Generate at least 32 random bytes and Base64-encode them. No runtime fallback key.
JWT_SIGNING_KEY_BASE64=
APP_PORT=8080
# Optional Telegram bot (empty = channel disabled).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Public web base for deep-links in messages, e.g. https://app.example.com
APP_PUBLIC_BASE=
# Optional SMTP (omit SPRING_MAIL_HOST to disable; empty host breaks health).
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
MAIL_FROM=
# Attachment storage: local (default) or dropbox.
ATTACHMENT_STORAGE=local
# ATTACHMENT_STORAGE=dropbox
# Prefer refresh OAuth (app folder):
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=
# Or short-lived access token only:
# DROPBOX_ACCESS_TOKEN=
# DROPBOX_APP_FOLDER=/projectflow
