file(MAKE_DIRECTORY "${DESTINATION}")
file(COPY "${ROOT}/LICENSE" DESTINATION "${DESTINATION}")
file(GLOB_RECURSE candidates RELATIVE "${ROOT}" "${ROOT}/third_party/*")
foreach(candidate IN LISTS candidates)
    get_filename_component(name "${candidate}" NAME)
    string(TOLOWER "${name}" normalized)
    if(normalized MATCHES "^(license|copying|copyright)")
        get_filename_component(directory "${candidate}" DIRECTORY)
        file(MAKE_DIRECTORY "${DESTINATION}/${directory}")
        file(COPY "${ROOT}/${candidate}" DESTINATION "${DESTINATION}/${directory}")
    endif()
endforeach()
