{
  "name": "projectflow-browser",
  "private": true,
  "type": "module",
  "scripts": {
    "check:alpha": "tsc -p alpha-jsconfig.json",
    "test:alpha": "node --test src/test/frontend/*.test.mjs",
    "test:browser": "playwright test",
    "check:workspace": "tsc -p frontend/tsconfig.json",
    "build:workspace": "node scripts/build-workspace.mjs",
    "test:workspace": "node --experimental-strip-types --test frontend/test/*.test.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
